# ============================================================
# MTN MoMo + PHP CONFIGURATION
# Copy this file to ".env" before running the application.
# NEVER commit your real .env file to Git.
# ============================================================

APP_ENV=sandbox

# >>> CHANGE THIS: your website/domain <<<
APP_URL=https://example.test

# >>> CHANGE THIS: generate a long random secret <<<
APP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# >>> CHANGE THIS: administrator username <<<
APP_ADMIN_USER=admin

# >>> CHANGE THIS: generate a password hash, then paste it here <<<
# Command:
# php -r "echo password_hash('YourStrongPasswordHere', PASSWORD_DEFAULT), PHP_EOL;"
APP_ADMIN_PASSWORD_HASH=CHANGE_THIS_TO_YOUR_PASSWORD_HASH


# ============================================================
# MYSQL DATABASE
# ============================================================

# >>> CHANGE THESE to match your MySQL server <<<
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mtn_momo
DB_USER=root
DB_PASS=


# ============================================================
# MTN MOMO COLLECTIONS
# ============================================================

# Sandbox values for testing.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox

# >>> CHANGE THIS: your MTN Collections subscription key <<<
MOMO_SUBSCRIPTION_KEY=YOUR_COLLECTION_PRIMARY_SUBSCRIPTION_KEY

# >>> CHANGE THIS: your MTN API User UUID <<<
MOMO_API_USER=YOUR_API_USER_UUID

# >>> CHANGE THIS: your MTN API Key <<<
MOMO_API_KEY=YOUR_API_KEY

# >>> CHANGE THIS: public HTTPS callback URL <<<
MOMO_CALLBACK_URL=https://example.test/callback.php

MOMO_CURRENCY=GHS
MOMO_PARTY_ID_TYPE=MSISDN
MOMO_COUNTRY_CODE=233
